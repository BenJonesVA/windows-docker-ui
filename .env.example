# Copy to .env and fill in before `docker compose up`.

# Signs the auth-session cookie (see webui/src/index.ts). Generate with:
#   openssl rand -hex 32
# Must stay fixed across restarts, or every session is invalidated on deploy.
COOKIE_SECRET=

# Set once a TLS-terminating reverse proxy sits in front of this service.
# Leave unset (false) only while testing over plain http:// on localhost —
# browsers silently drop Secure cookies over http, which breaks login.
COOKIE_SECURE=true
